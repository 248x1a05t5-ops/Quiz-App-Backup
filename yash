import 'package:flutter/material.dart';

void main() {
  runApp(const QuizApp());
}

class QuizApp extends StatelessWidget {
  const QuizApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Super Quiz App',
      theme: ThemeData(
        primarySwatch: Colors.teal,
        scaffoldBackgroundColor: Colors.blueGrey[50],
      ),
      home: const QuizHomePage(),
    );
  }
}

class QuizHomePage extends StatefulWidget {
  const QuizHomePage({super.key});

  @override
  State<QuizHomePage> createState() => _QuizHomePageState();
}

class _QuizHomePageState extends State<QuizHomePage> {
  int _currentQuestionIndex = 0;
  int _score = 0;

  final List<Map<String, Object>> _questions = [
    {
      'questionText': '1. Which programming language is used by Flutter?',
      'answers': ['Python', 'Java', 'Dart', 'Kotlin'],
      'correctAnswer': 'Dart',
    },
    {
      'questionText': '2. Who developed Flutter?',
      'answers': ['Facebook', 'Google', 'Microsoft', 'Apple'],
      'correctAnswer': 'Google',
    },
    {
      'questionText': '3. What is the capital of India?',
      'answers': ['Mumbai', 'New Delhi', 'Hyderabad', 'Bengaluru'],
      'correctAnswer': 'New Delhi',
    },
    {
      'questionText': '4. Which planet is called the Red Planet?',
      'answers': ['Earth', 'Mars', 'Jupiter', 'Saturn'],
      'correctAnswer': 'Mars',
    },
    {
      'questionText': '5. What is the largest ocean?',
      'answers': [
        'Atlantic Ocean',
        'Indian Ocean',
        'Arctic Ocean',
        'Pacific Ocean'
      ],
      'correctAnswer': 'Pacific Ocean',
    },
    {
      'questionText': '6. Which Flutter widget displays text?',
      'answers': ['Text', 'Container', 'Row', 'Column'],
      'correctAnswer': 'Text',
    },
    {
      'questionText': '7. Which company developed Android?',
      'answers': ['Apple', 'Google', 'Samsung', 'Microsoft'],
      'correctAnswer': 'Google',
    },
    {
      'questionText': '8. How many days are in a leap year?',
      'answers': ['365', '366', '364', '360'],
      'correctAnswer': '366',
    },
    {
      'questionText': '9. Which is the largest planet?',
      'answers': ['Earth', 'Mars', 'Jupiter', 'Venus'],
      'correctAnswer': 'Jupiter',
    },
    {
      'questionText': '10. What does CPU stand for?',
      'answers': [
        'Central Processing Unit',
        'Computer Personal Unit',
        'Central Program Utility',
        'Control Processing User'
      ],
      'correctAnswer': 'Central Processing Unit',
    },
    {
      'questionText': '11. Which language styles web pages?',
      'answers': ['HTML', 'CSS', 'Python', 'C++'],
      'correctAnswer': 'CSS',
    },
    {
      'questionText': '12. What is the national animal of India?',
      'answers': ['Lion', 'Elephant', 'Tiger', 'Leopard'],
      'correctAnswer': 'Tiger',
    },
    {
      'questionText': '13. How many colors are in a rainbow?',
      'answers': ['5', '6', '7', '8'],
      'correctAnswer': '7',
    },
    {
      'questionText': '14. Which widget arranges items vertically?',
      'answers': ['Row', 'Column', 'Stack', 'Center'],
      'correctAnswer': 'Column',
    },
    {
      'questionText': '15. What is the fastest land animal?',
      'answers': ['Lion', 'Horse', 'Cheetah', 'Tiger'],
      'correctAnswer': 'Cheetah',
    },
    {
      'questionText': '16. What does HTML stand for?',
      'answers': [
        'Hyper Text Markup Language',
        'High Tech Modern Language',
        'Hyper Transfer Machine Language',
        'Home Tool Markup Language'
      ],
      'correctAnswer': 'Hyper Text Markup Language',
    },
    {
      'questionText': '17. What is the smallest prime number?',
      'answers': ['0', '1', '2', '3'],
      'correctAnswer': '2',
    },
    {
      'questionText': '18. Which device is used to type?',
      'answers': ['Monitor', 'Keyboard', 'Speaker', 'Printer'],
      'correctAnswer': 'Keyboard',
    },
    {
      'questionText': '19. Which is the longest river in India?',
      'answers': ['Yamuna', 'Godavari', 'Ganga', 'Krishna'],
      'correctAnswer': 'Ganga',
    },
    {
      'questionText': '20. Which widget manages changing state in Flutter?',
      'answers': [
        'StatelessWidget',
        'Text',
        'StatefulWidget',
        'Image'
      ],
      'correctAnswer': 'StatefulWidget',
    },
  ];

  void _answerQuestion(String selectedAnswer) {
    if (_currentQuestionIndex >= _questions.length) {
      return;
    }

    setState(() {
      if (selectedAnswer ==
          _questions[_currentQuestionIndex]['correctAnswer']) {
        _score++;
      }

      _currentQuestionIndex++;
    });
  }

  void _resetQuiz() {
    setState(() {
      _currentQuestionIndex = 0;
      _score = 0;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'Super Quiz App',
          style: TextStyle(
            fontWeight: FontWeight.bold,
            color: Colors.white,
          ),
        ),
        backgroundColor: Colors.teal,
        centerTitle: true,
        elevation: 5,
      ),
      body: Center(
        child: SingleChildScrollView(
          physics: const BouncingScrollPhysics(),
          child: Padding(
            padding: const EdgeInsets.all(20.0),
            child: _currentQuestionIndex < _questions.length
                ? Column(
                    crossAxisAlignment: CrossAxisAlignment.stretch,
                    children: [
                      Text(
                        'Question ${_currentQuestionIndex + 1} '
                        'of ${_questions.length}',
                        textAlign: TextAlign.center,
                        style: const TextStyle(
                          fontSize: 18,
                          fontWeight: FontWeight.bold,
                          color: Colors.teal,
                        ),
                      ),

                      const SizedBox(height: 15),

                      LinearProgressIndicator(
                        value: (_currentQuestionIndex + 1) /
                            _questions.length,
                        backgroundColor: Colors.grey,
                        color: Colors.teal,
                        minHeight: 8,
                      ),

                      const SizedBox(height: 25),

                      Card(
                        elevation: 4,
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(15),
                        ),
                        child: Padding(
                          padding: const EdgeInsets.all(20.0),
                          child: Text(
                            _questions[_currentQuestionIndex]
                                ['questionText'] as String,
                            style: const TextStyle(
                              fontSize: 20,
                              fontWeight: FontWeight.bold,
                              color: Colors.blueGrey,
                            ),
                            textAlign: TextAlign.center,
                          ),
                        ),
                      ),

                      const SizedBox(height: 25),

                      ...(_questions[_currentQuestionIndex]['answers']
                              as List<String>)
                          .map((answer) {
                        return Padding(
                          padding: const EdgeInsets.symmetric(
                            vertical: 5.0,
                          ),
                          child: ElevatedButton(
                            style: ElevatedButton.styleFrom(
                              backgroundColor: Colors.teal,
                              foregroundColor: Colors.white,
                              padding: const EdgeInsets.symmetric(
                                vertical: 15,
                              ),
                              shape: RoundedRectangleBorder(
                                borderRadius: BorderRadius.circular(30),
                              ),
                            ),
                            onPressed: () =>
                                _answerQuestion(answer),
                            child: Text(
                              answer,
                              style: const TextStyle(
                                fontSize: 16,
                                fontWeight: FontWeight.w500,
                              ),
                            ),
                          ),
                        );
                      }),
                    ],
                  )
                : Card(
                    elevation: 5,
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(20),
                    ),
                    child: Padding(
                      padding: const EdgeInsets.all(30.0),
                      child: Column(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          const Icon(
                            Icons.emoji_events,
                            size: 70,
                            color: Colors.amber,
                          ),

                          const SizedBox(height: 15),

                          const Text(
                            'Quiz Finished!',
                            style: TextStyle(
                              fontSize: 26,
                              fontWeight: FontWeight.bold,
                              color: Colors.teal,
                            ),
                          ),

                          const SizedBox(height: 15),

                          Text(
                            'Your Score: $_score / ${_questions.length}',
                            style: const TextStyle(
                              fontSize: 20,
                              fontWeight: FontWeight.w500,
                            ),
                          ),

                          const SizedBox(height: 25),

                          ElevatedButton.icon(
                            style: ElevatedButton.styleFrom(
                              backgroundColor: Colors.blueGrey,
                              foregroundColor: Colors.white,
                              padding: const EdgeInsets.symmetric(
                                horizontal: 25,
                                vertical: 12,
                              ),
                              shape: RoundedRectangleBorder(
                                borderRadius: BorderRadius.circular(20),
                              ),
                            ),
                            onPressed: _resetQuiz,
                            icon: const Icon(Icons.refresh),
                            label: const Text(
                              'Restart Quiz',
                              style: TextStyle(fontSize: 16),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
          ),
        ),
      ),
    );
  }
}
